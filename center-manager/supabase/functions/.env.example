# Copy to .env.test.local (ignored by Git). Use the billing MID's matching TEST API keys.
TOSS_ENVIRONMENT=test
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# Comma-separated UUIDs from Authentication > Users. Only these users can test payments.
TOSS_TEST_USER_IDS=
APP_SITE_URL=https://k2551344-creator.github.io/myweb1/
# Random 32 bytes encoded as base64. Keep stable and back up securely.
PAYMENT_ENCRYPTION_KEY=
# Random secret of at least 32 characters; use the identical value in Vault.
CRON_SECRET=
# Set true only after setup 10 and the scheduled request are verified.
BILLING_SCHEDULER_READY=false
# Hosted Edge Functions supply SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY automatically.
